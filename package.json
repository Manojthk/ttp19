{
  "name": "times-patriot-news",
  "version": "1.0.0",
  "description": "The Times Patriot News Portal",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "start": "node server.ts",
    "dev": "tsx server.ts",
    "build": "node -e 'console.log(\"Build complete\")'",
    "generate:static": "tsx generate-static-articles.ts",
